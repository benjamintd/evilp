 #endif /* HAVE_GETRUSAGE */
+
+/* Wall time used for simplex budgets, including time descheduled while awake. */
+double ILLutil_deadline_zeit (void)
+{
+    struct timespec ts;
+#ifdef __APPLE__
+    const clockid_t clockid = CLOCK_UPTIME_RAW;
+#else
+    const clockid_t clockid = CLOCK_MONOTONIC;
+#endif
+    if (clock_gettime(clockid, &ts) != 0)
+        abort();
+    return (double) ts.tv_sec + (double) ts.tv_nsec / 1e9;
+}
 
 double ILLutil_real_zeit (
 	void)
