+EGLPNUM_TYPENAME_QSLIB_INTERFACE int EGLPNUM_TYPENAME_QSget_binv_row_sparse (
+	EGLPNUM_TYPENAME_QSdata * p,
+	int indx,
+	EGLPNUM_TYPE * binvrow,
+	int *inds,
+	int *ninds)
+{
+	int rval = 0;
+
+	rval = check_qsdata_pointer (p);
+	CHECKRVALG (rval, CLEANUP);
+
+	if (p->basis == 0)
+	{
+		QSlog("no active basis in store");
+		rval = 1;
+		goto CLEANUP;
+	}
+	if (0 > indx || indx >= EGLPNUM_TYPENAME_QSget_rowcount(p))
+	{
+		rval = 1;
+		goto CLEANUP;
+	}
+	if (p->cache == 0)
+	{
+		rval = 1;
+		goto CLEANUP;
+	}
+	if (p->factorok && p->lp->f != 0 && p->lp->basisid != -1)
+		p->lp->fbasisid = p->lp->basisid;
+
+	rval = EGLPNUM_TYPENAME_ILLlib_binv_row_sparse (p->lp, indx, binvrow, inds, ninds);
+	CHECKRVALG (rval, CLEANUP);
+
+CLEANUP:
+
+	EG_RETURN (rval);
+}
