+int EGLPNUM_TYPENAME_ILLlib_binv_row_sparse (
+	EGLPNUM_TYPENAME_lpinfo * lp,
+	int row,
+	EGLPNUM_TYPE * binv,
+	int *inds,
+	int *ninds)
+{
+	int rval = 0;
+	int i, singular = 0;
+	int nrows = lp->O->nrows;
+
+	if (row < 0 || row >= nrows)
+	{
+		rval = 1;
+		ILL_CLEANUP;
+	}
+	if (lp->basisid == -1)
+	{
+		rval = E_GENERAL_ERROR;
+		ILL_CLEANUP;
+	}
+	if (lp->fbasisid != lp->basisid || lp->f == 0)
+	{
+		rval = EGLPNUM_TYPENAME_ILLbasis_factor (lp, &singular);
+		CHECKRVALG (rval, CLEANUP);
+		if (singular)
+		{
+			rval = E_BASIS_SINGULAR;
+			ILL_CLEANUP;
+		}
+	}
+	if (lp->zz.indx == 0)
+	{
+		rval = EGLPNUM_TYPENAME_ILLsvector_alloc (&(lp->zz), lp->nrows);
+		CHECKRVALG (rval, CLEANUP);
+	}
+	EGLPNUM_TYPENAME_ILLfct_compute_zz (lp, &(lp->zz), row);
+	for (i = 0; i < nrows; i++)
+		EGLPNUM_TYPENAME_EGlpNumZero (binv[i]);
+	for (i = 0; i < lp->zz.nzcnt; i++)
+	{
+		int idx = lp->zz.indx[i];
+		EGLPNUM_TYPENAME_EGlpNumCopy (binv[idx], lp->zz.coef[i]);
+		if (inds)
+			inds[i] = idx;
+	}
+	if (ninds)
+		*ninds = lp->zz.nzcnt;
+
+CLEANUP:
+	EG_RETURN (rval);
+}
+
+int EGLPNUM_TYPENAME_ILLlib_tableau_row_sparse (
+	EGLPNUM_TYPENAME_lpinfo * lp,
+	int row,
+	EGLPNUM_TYPE * tabrow,
+	int *inds,
+	int *ninds)
+{
+	int rval = 0;
+	int i, singular = 0, out_nz = 0;
+	EGLPNUM_TYPENAME_ILLlpdata *qslp = lp->O;
+	int nrows = qslp->nrows;
+	int ncols = qslp->ncols;
+	int nstruct = qslp->nstruct;
+
+	if (row < 0 || row >= nrows)
+	{
+		rval = 1;
+		ILL_CLEANUP;
+	}
+	if (lp->basisid == -1)
+	{
+		rval = E_GENERAL_ERROR;
+		ILL_CLEANUP;
+	}
+	if (lp->fbasisid != lp->basisid || lp->f == 0)
+	{
+		rval = EGLPNUM_TYPENAME_ILLbasis_factor (lp, &singular);
+		CHECKRVALG (rval, CLEANUP);
+		if (singular)
+		{
+			rval = E_BASIS_SINGULAR;
+			ILL_CLEANUP;
+		}
+	}
+	if (!lp->internal_valid || lp->zz.indx == 0 || lp->zA.indx == 0)
+	{
+		/* Fallback to dense path if internal row representation is unavailable. */
+		EGLPNUM_TYPE *full = EGLPNUM_TYPENAME_EGlpNumAllocArray (nstruct + nrows);
+		rval = EGLPNUM_TYPENAME_ILLlib_tableau (lp, row, 0, full);
+		if (!rval)
+		{
+			for (i = 0; i < nstruct; i++)
+				EGLPNUM_TYPENAME_EGlpNumCopy (tabrow[i], full[i]);
+			if (ninds)
+				*ninds = -1;
+		}
+		EGLPNUM_TYPENAME_EGlpNumFreeArray (full);
+		ILL_CLEANUP;
+	}
+	if (!lp->inv_structmap_valid || ncols > lp->inv_structmap_cap)
+	{
+		if (ncols > lp->inv_structmap_cap)
+		{
+			int cap = ncols + (ncols >> 2) + 32;
+			ILL_IFFREE(lp->inv_structmap);
+			lp->inv_structmap_cap = 0;
+			ILL_SAFE_MALLOC (lp->inv_structmap, cap, int);
+			lp->inv_structmap_cap = cap;
+		}
+		for (i = 0; i < ncols; i++)
+			lp->inv_structmap[i] = -1;
+		for (i = 0; i < nstruct; i++)
+			lp->inv_structmap[qslp->structmap[i]] = i;
+		lp->inv_structmap_valid = 1;
+	}
+
+	EGLPNUM_TYPENAME_ILLfct_compute_zz (lp, &(lp->zz), row);
+	rval = EGLPNUM_TYPENAME_ILLfct_compute_zA (lp, &(lp->zz), &(lp->zA));
+	CHECKRVALG (rval, CLEANUP);
+
+	for (i = 0; i < nstruct; i++)
+		EGLPNUM_TYPENAME_EGlpNumZero (tabrow[i]);
+
+	for (i = 0; i < lp->zA.nzcnt; i++)
+	{
+		int ext = lp->inv_structmap[lp->nbaz[lp->zA.indx[i]]];
+		if (ext >= 0)
+		{
+			EGLPNUM_TYPENAME_EGlpNumCopy (tabrow[ext], lp->zA.coef[i]);
+			if (inds)
+				inds[out_nz] = ext;
+			out_nz++;
+		}
+	}
+	{
+		int bext = lp->inv_structmap[lp->baz[row]];
+		if (bext >= 0)
+		{
+			EGLPNUM_TYPENAME_EGlpNumOne (tabrow[bext]);
+			if (inds)
+				inds[out_nz] = bext;
+			out_nz++;
+		}
+	}
+	if (ninds)
+		*ninds = out_nz;
+
+CLEANUP:
 	EG_RETURN (rval);
 }
 
