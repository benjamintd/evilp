+			EGLPNUM_TYPENAME_EGlpNumZero (t);
+
+		rval = EGLPNUM_TYPENAME_ILLlib_chgbnd (lp, k, 'U', t);
+		CHECKRVALG (rval, CLEANUP);
+
+		{
