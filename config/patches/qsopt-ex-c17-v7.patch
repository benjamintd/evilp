+static void longdII_select_prefix (
+	EGLPNUM_TYPENAME_lpinfo * lp,
+	int lvstat,
+	int *perm,
+	int *ix,
+	EGLPNUM_TYPE * t,
+	int tctr,
+	EGLPNUM_TYPE rcost_init,
+	EGLPNUM_TYPE pftol,
+	int *out_hi)
+{
+	int lo = 0, hi = tctr;
+	EGLPNUM_TYPE rcost_cur, piv, delta_lt, delta_eq, th;
+	EGLPNUM_TYPENAME_EGlpNumInitVar (rcost_cur);
+	EGLPNUM_TYPENAME_EGlpNumInitVar (piv);
+	EGLPNUM_TYPENAME_EGlpNumInitVar (delta_lt);
+	EGLPNUM_TYPENAME_EGlpNumInitVar (delta_eq);
+	EGLPNUM_TYPENAME_EGlpNumInitVar (th);
+	EGLPNUM_TYPENAME_EGlpNumCopy (rcost_cur, rcost_init);
+
+	while (hi - lo > 24)
+	{
+		int mid = lo + ((hi - lo) >> 1);
+		int last = hi - 1;
+		int tmp;
+		if (EGLPNUM_TYPENAME_EGlpNumIsLess (t[perm[mid]], t[perm[lo]]))
+		{ tmp = perm[lo]; perm[lo] = perm[mid]; perm[mid] = tmp; }
+		if (EGLPNUM_TYPENAME_EGlpNumIsLess (t[perm[last]], t[perm[lo]]))
+		{ tmp = perm[lo]; perm[lo] = perm[last]; perm[last] = tmp; }
+		if (EGLPNUM_TYPENAME_EGlpNumIsLess (t[perm[last]], t[perm[mid]]))
+		{ tmp = perm[mid]; perm[mid] = perm[last]; perm[last] = tmp; }
+		EGLPNUM_TYPENAME_EGlpNumCopy (piv, t[perm[mid]]);
+
+		int lt = lo, i = lo, gt = hi;
+		while (i < gt)
+		{
+			if (EGLPNUM_TYPENAME_EGlpNumIsLess (t[perm[i]], piv))
+			{
+				tmp = perm[lt]; perm[lt] = perm[i]; perm[i] = tmp;
+				lt++; i++;
+			}
+			else if (EGLPNUM_TYPENAME_EGlpNumIsLess (piv, t[perm[i]]))
+			{
+				gt--;
+				tmp = perm[i]; perm[i] = perm[gt]; perm[gt] = tmp;
+			}
+			else
+			{
+				i++;
+			}
+		}
+
+		EGLPNUM_TYPENAME_EGlpNumCopy (delta_lt, rcost_cur);
+		for (int m = lo; m < lt; m++)
+		{
+			int k = ix[perm[m]];
+			int indx = lp->zA.indx[k];
+			int col = lp->nbaz[indx];
+			EGLPNUM_TYPENAME_EGlpNumCopyDiff (th, lp->lz[col], lp->uz[col]);
+			EGLPNUM_TYPENAME_EGlpNumMultTo (th, lp->zA.coef[k]);
+			if (lp->vstat[col] != STAT_UPPER)
+				EGLPNUM_TYPENAME_EGlpNumSign (th);
+			if (lvstat == STAT_LOWER)
+				EGLPNUM_TYPENAME_EGlpNumAddTo (delta_lt, th);
+			else
+				EGLPNUM_TYPENAME_EGlpNumSubTo (delta_lt, th);
+		}
+
+		if (EGLPNUM_TYPENAME_EGlpNumIsLeq (delta_lt, pftol))
+		{
+			if (EGLPNUM_TYPENAME_EGlpNumIsGreatZero (piv))
+			{
+				hi = lt;
+				continue;
+			}
+			break;
+		}
+
+		EGLPNUM_TYPENAME_EGlpNumCopy (delta_eq, delta_lt);
+		for (int m = lt; m < gt; m++)
+		{
+			int k = ix[perm[m]];
+			int indx = lp->zA.indx[k];
+			int col = lp->nbaz[indx];
+			EGLPNUM_TYPENAME_EGlpNumCopyDiff (th, lp->lz[col], lp->uz[col]);
+			EGLPNUM_TYPENAME_EGlpNumMultTo (th, lp->zA.coef[k]);
+			if (lp->vstat[col] != STAT_UPPER)
+				EGLPNUM_TYPENAME_EGlpNumSign (th);
+			if (lvstat == STAT_LOWER)
+				EGLPNUM_TYPENAME_EGlpNumAddTo (delta_eq, th);
+			else
+				EGLPNUM_TYPENAME_EGlpNumSubTo (delta_eq, th);
+		}
+
+		if (EGLPNUM_TYPENAME_EGlpNumIsLeq (delta_eq, pftol))
+		{
+			if (!EGLPNUM_TYPENAME_EGlpNumIsLessZero (piv))
+				hi = gt;
+			break;
+		}
+
+		EGLPNUM_TYPENAME_EGlpNumCopy (rcost_cur, delta_eq);
+		lo = gt;
+	}
+
+	EGLPNUM_TYPENAME_EGlpNumClearVar (rcost_cur);
+	EGLPNUM_TYPENAME_EGlpNumClearVar (piv);
+	EGLPNUM_TYPENAME_EGlpNumClearVar (delta_lt);
+	EGLPNUM_TYPENAME_EGlpNumClearVar (delta_eq);
+	EGLPNUM_TYPENAME_EGlpNumClearVar (th);
+	*out_hi = hi;
+}
