+static void longdII_sort_tie_desc_absz (
+	int *perm,
+	const int *ix,
+	const EGLPNUM_TYPE *zAcoef,
+	int n)
+{
+	EGLPNUM_TYPE a, b;
+	int start, end;
+
+	if (n <= 1)
+		return;
+	EGLPNUM_TYPENAME_EGlpNumInitVar (a);
+	EGLPNUM_TYPENAME_EGlpNumInitVar (b);
+
+	/* Min-heap by |zAj| so pop-to-end yields descending |zAj| order in O(n log n). */
+	for (start = (n - 2) / 2; start >= 0; start--)
+	{
+		int root = start;
+		while (root * 2 + 1 < n)
+		{
+			int child = root * 2 + 1;
+			int swp = root;
+			EGLPNUM_TYPENAME_EGlpNumCopyAbs (a, zAcoef[ix[perm[swp]]]);
+			EGLPNUM_TYPENAME_EGlpNumCopyAbs (b, zAcoef[ix[perm[child]]]);
+			if (EGLPNUM_TYPENAME_EGlpNumIsLess (b, a))
+			{
+				swp = child;
+				EGLPNUM_TYPENAME_EGlpNumCopy (a, b);
+			}
+			if (child + 1 < n)
+			{
+				EGLPNUM_TYPENAME_EGlpNumCopyAbs (b, zAcoef[ix[perm[child + 1]]]);
+				if (EGLPNUM_TYPENAME_EGlpNumIsLess (b, a))
+					swp = child + 1;
+			}
+			if (swp == root)
+				break;
+			{
+				int tmp = perm[root];
+				perm[root] = perm[swp];
+				perm[swp] = tmp;
+			}
+			root = swp;
+		}
+	}
+
+	for (end = n - 1; end > 0; end--)
+	{
+		int tmp = perm[end];
+		int root = 0;
+		perm[end] = perm[0];
+		perm[0] = tmp;
+		while (root * 2 + 1 < end)
+		{
+			int child = root * 2 + 1;
+			int swp = root;
+			EGLPNUM_TYPENAME_EGlpNumCopyAbs (a, zAcoef[ix[perm[swp]]]);
+			EGLPNUM_TYPENAME_EGlpNumCopyAbs (b, zAcoef[ix[perm[child]]]);
+			if (EGLPNUM_TYPENAME_EGlpNumIsLess (b, a))
+			{
+				swp = child;
+				EGLPNUM_TYPENAME_EGlpNumCopy (a, b);
+			}
+			if (child + 1 < end)
+			{
+				EGLPNUM_TYPENAME_EGlpNumCopyAbs (b, zAcoef[ix[perm[child + 1]]]);
+				if (EGLPNUM_TYPENAME_EGlpNumIsLess (b, a))
+					swp = child + 1;
+			}
+			if (swp == root)
+				break;
+			tmp = perm[root];
+			perm[root] = perm[swp];
+			perm[swp] = tmp;
+			root = swp;
+		}
+	}
+
+	EGLPNUM_TYPENAME_EGlpNumClearVar (b);
+	EGLPNUM_TYPENAME_EGlpNumClearVar (a);
 }
 
