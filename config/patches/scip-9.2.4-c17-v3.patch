+/** helper to strong-branch one fractional candidate warm-started from current factorization */
+static
+SCIP_RETCODE lpiStrongbranchFracOne(
+   SCIP_LPI*             lpi,
+   int                   col,
+   SCIP_Real             psol,
+   int                   itlim,
+   SCIP_Real*            down,
+   SCIP_Real*            up,
+   SCIP_Bool*            downvalid,
+   SCIP_Bool*            upvalid,
+   int*                  iter
+   )
+{
+   double oldlb = 0.0;
+   double oldub = 0.0;
+   double objlim = QS_MAXDOUBLE;
+   double newub;
+   double newlb;
+   int objsen = QS_MIN;
+   int olditlim = 500000;
+   int sbstat = 0;
+   int nit = 0;
+   int rval;
+
+   *downvalid = FALSE;
+   *upvalid = FALSE;
+   if( down != NULL )
+      *down = lpi->sb_active ? lpi->sb_objval : 0.0;
+   if( up != NULL )
+      *up = lpi->sb_active ? lpi->sb_objval : 0.0;
+
+   QS_CONDRET( QSget_objsense(lpi->prob, &objsen) );
+   (void)QSget_param_double(lpi->prob, objsen == QS_MIN ? QS_PARAM_OBJULIM : QS_PARAM_OBJLLIM, &objlim);
+   QS_CONDRET( QSget_bounds_list(lpi->prob, 1, &col, &oldlb, &oldub) );
+   (void)QSget_param(lpi->prob, QS_PARAM_SIMPLEX_MAX_ITERATIONS, &olditlim);
+   (void)QSset_param(lpi->prob, QS_PARAM_SIMPLEX_MAX_ITERATIONS, itlim > 0 ? itlim : 1);
+
+   /* down branch: x_col <= floor(psol) */
+   newub = EPSCEIL(psol - 1.0, FEASTOL);
+   if( down != NULL )
+   {
+      if( newub < oldlb - FEASTOL )
+      {
+         *down = (objsen == QS_MIN ? QS_MAXDOUBLE : -QS_MAXDOUBLE);
+         *downvalid = TRUE;
+      }
+      else
+      {
+         if( newub < oldlb )
+            newub = oldlb;
+         rval = QSchange_bound(lpi->prob, col, 'U', newub);
+         if( rval == 0 )
+         {
+            sbstat = 0;
+            rval = QSopt_dual(lpi->prob, &sbstat);
+            if( rval == 0 )
+            {
+               if( sbstat == QS_LP_OPTIMAL )
+               {
+                  if( QSget_objval(lpi->prob, down) == 0 )
+                     *downvalid = TRUE;
+               }
+               else if( sbstat == QS_LP_INFEASIBLE )
+               {
+                  *down = (objsen == QS_MIN ? QS_MAXDOUBLE : -QS_MAXDOUBLE);
+                  *downvalid = TRUE;
+               }
+               else if( sbstat == QS_LP_OBJ_LIMIT )
+               {
+                  *down = objlim;
+                  *downvalid = TRUE;
+               }
+               else if( sbstat == QS_LP_ITER_LIMIT || sbstat == QS_LP_TIME_LIMIT )
+               {
+                  (void)QSget_objval(lpi->prob, down);
+               }
+               else if( lpi->sb_active )
+               {
+                  (void)QSload_basis_array(lpi->prob, lpi->sb_cstat, lpi->sb_rstat);
+               }
+            }
+            else if( lpi->sb_active )
+            {
+               (void)QSload_basis_array(lpi->prob, lpi->sb_cstat, lpi->sb_rstat);
+            }
+            (void)QSchange_bound(lpi->prob, col, 'U', oldub);
+         }
+      }
+   }
+
+   /* up branch: x_col >= ceil(psol) */
+   newlb = EPSFLOOR(psol + 1.0, FEASTOL);
+   if( up != NULL )
+   {
+      if( newlb > oldub + FEASTOL )
+      {
+         *up = (objsen == QS_MIN ? QS_MAXDOUBLE : -QS_MAXDOUBLE);
+         *upvalid = TRUE;
+      }
+      else
+      {
+         if( newlb > oldub )
+            newlb = oldub;
+         rval = QSchange_bound(lpi->prob, col, 'L', newlb);
+         if( rval == 0 )
+         {
+            sbstat = 0;
+            rval = QSopt_dual(lpi->prob, &sbstat);
+            if( rval == 0 )
+            {
+               if( sbstat == QS_LP_OPTIMAL )
+               {
+                  if( QSget_objval(lpi->prob, up) == 0 )
+                     *upvalid = TRUE;
+               }
+               else if( sbstat == QS_LP_INFEASIBLE )
+               {
+                  *up = (objsen == QS_MIN ? QS_MAXDOUBLE : -QS_MAXDOUBLE);
+                  *upvalid = TRUE;
+               }
+               else if( sbstat == QS_LP_OBJ_LIMIT )
+               {
+                  *up = objlim;
+                  *upvalid = TRUE;
+               }
+               else if( sbstat == QS_LP_ITER_LIMIT || sbstat == QS_LP_TIME_LIMIT )
+               {
+                  (void)QSget_objval(lpi->prob, up);
+               }
+               else if( lpi->sb_active )
+               {
+                  (void)QSload_basis_array(lpi->prob, lpi->sb_cstat, lpi->sb_rstat);
+               }
+            }
+            else if( lpi->sb_active )
+            {
+               (void)QSload_basis_array(lpi->prob, lpi->sb_cstat, lpi->sb_rstat);
+            }
+            (void)QSchange_bound(lpi->prob, col, 'L', oldlb);
+         }
+      }
+   }
+
+   (void)QSset_param(lpi->prob, QS_PARAM_SIMPLEX_MAX_ITERATIONS, olditlim);
+   QS_CONDRET( QSget_itcnt(lpi->prob, 0, 0, 0, 0, &nit) );
+   if( iter != NULL )
+      *iter = nit - lpi->previt;
+   lpi->previt = nit;
+
    return SCIP_OKAY;
 }
 
