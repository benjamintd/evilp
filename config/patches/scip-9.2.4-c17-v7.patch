+/** copies limits to a primal heuristic sub-SCIP, optionally capping its time limit */
+SCIP_RETCODE SCIPcopyLimitsHeur(
+   SCIP*                 sourcescip,         /**< source SCIP data structure */
+   SCIP*                 targetscip          /**< target SCIP data structure */
+   )
+{
+   SCIP_Real frac;
+   SCIP_Real timelimit;
+
+   SCIP_CALL( SCIPcopyLimits(sourcescip, targetscip) );
+
+   if( SCIPgetParam(sourcescip, "heuristics/subsciptimefrac") == NULL )
+      return SCIP_OKAY;
+   SCIP_CALL( SCIPgetRealParam(sourcescip, "heuristics/subsciptimefrac", &frac) );
+   if( frac >= 1.0 )
+      return SCIP_OKAY;
+
+   SCIP_CALL( SCIPgetRealParam(targetscip, "limits/time", &timelimit) );
+   if( SCIPisInfinity(targetscip, timelimit) )
+      return SCIP_OKAY;
+   timelimit *= MAX(frac, 0.0);
+   SCIP_CALL( SCIPsetRealParam(targetscip, "limits/time", timelimit) );
+
+   return SCIP_OKAY;
+}
