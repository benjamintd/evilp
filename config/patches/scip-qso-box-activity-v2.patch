+/* Slack reconstruction can cancel the entire activity near the middle of
+ * a very wide interval. Evaluate these rows at the returned structural point. */
+static SCIP_RETCODE getBoxActivities(SCIP_LPI* lpi, double* primal, double* activity, int count)
+{
+   int* lengths = NULL;
+   int* starts = NULL;
+   int* indices = NULL;
+   double* values = NULL;
+   double* allocated = NULL;
+   SCIP_RETCODE rc = SCIP_LPERROR;
+   if( primal == NULL )
+   {
+      int ncols = QSget_colcount(lpi->prob);
+      allocated = malloc((size_t)(ncols ? ncols : 1) * sizeof(*allocated));
+      if( allocated == NULL )
+         return SCIP_NOMEMORY;
+      primal = allocated;
+      if( dbl_QSget_x_array(lpi->prob, primal) )
+         goto done;
+   }
+   if( QSget_ranged_rows_list(lpi->prob, count, lpi->ircnt, &lengths, &starts,
+                              &indices, &values, NULL, NULL, NULL, NULL) )
+      goto done;
+   for( int row = 0; row < count; ++row )
+   {
+      double sum = 0.0;
+      double correction = 0.0;
+      for( int j = 0; j < lengths[row]; ++j )
+      {
+         int k = starts[row] + j;
+         double x = primal[indices[k]];
+         double product = values[k] * x;
+         double next = sum + product;
+         correction += fma(values[k], x, -product);
+         correction += fabs(sum) >= fabs(product) ? (sum - next) + product : (product - next) + sum;
+         sum = next;
+      }
+      activity[lpi->ircnt[row]] = sum + correction;
+   }
+   rc = SCIP_OKAY;
+done:
+   QSfree(lengths);
+   QSfree(starts);
+   QSfree(indices);
+   if( values != NULL )
+      dbl_QSfree_numeric_array(values);
+   free(allocated);
+   return rc;
+}
