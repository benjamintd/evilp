+static void pf_apply_ftran (
+	EGLPNUM_TYPENAME_factor_work * f,
+	EGLPNUM_TYPENAME_svector * x)
+{
+	EGLPNUM_TYPE *work = f->work_coef;
+	int *list = f->work_indx;
+	unsigned char *mark = f->pf_mark;
+	int n = 0, i, k, out_nz = 0;
+	EGLPNUM_TYPE alpha;
+
+	EGLPNUM_TYPENAME_EGlpNumInitVar (alpha);
+	for (i = 0; i < x->nzcnt; i++)
+	{
+		int idx = x->indx[i];
+		EGLPNUM_TYPENAME_EGlpNumCopy (work[idx], x->coef[i]);
+		if (!mark[idx])
+		{
+			mark[idx] = 1;
+			list[n++] = idx;
+		}
+	}
+	for (k = 0; k < f->pf_cnt; k++)
+	{
+		int p = f->pf_p[k];
+		if (!mark[p] || !EGLPNUM_TYPENAME_EGlpNumIsNeqqZero (work[p]))
+			continue;
+		EGLPNUM_TYPENAME_EGlpNumCopyFrac (alpha, work[p], f->pf_piv[k]);
+		EGLPNUM_TYPENAME_EGlpNumCopy (work[p], alpha);
+		{
+			int beg = f->pf_beg[k];
+			int cnt = f->pf_nzcnt[k];
+			int *indx = f->pf_indx + beg;
+			EGLPNUM_TYPE *coef = f->pf_coef + beg;
+			for (i = 0; i < cnt; i++)
+			{
+				int idx = indx[i];
+				EGLPNUM_TYPENAME_EGlpNumSubInnProdTo (work[idx], alpha, coef[i]);
+				if (!mark[idx])
+				{
+					mark[idx] = 1;
+					list[n++] = idx;
+				}
+			}
+		}
+	}
+	for (i = 0; i < n; i++)
+	{
+		int idx = list[i];
+		mark[idx] = 0;
+		if (EGLPNUM_TYPENAME_EGlpNumIsNeqZero (work[idx], f->szero_tol))
+		{
+			x->indx[out_nz] = idx;
+			EGLPNUM_TYPENAME_EGlpNumCopy (x->coef[out_nz], work[idx]);
+			out_nz++;
+		}
+		EGLPNUM_TYPENAME_EGlpNumZero (work[idx]);
+	}
+	x->nzcnt = out_nz;
+	EGLPNUM_TYPENAME_EGlpNumClearVar (alpha);
+}
+
+static void pf_apply_btran (
+	EGLPNUM_TYPENAME_factor_work * f,
+	EGLPNUM_TYPENAME_svector * a,
+	EGLPNUM_TYPENAME_svector * out)
+{
+	EGLPNUM_TYPE *work = f->work_coef;
+	int *list = f->work_indx;
+	unsigned char *mark = f->pf_mark;
+	int n = 0, i, k, out_nz = 0;
+	EGLPNUM_TYPE dot;
+
+	EGLPNUM_TYPENAME_EGlpNumInitVar (dot);
+	for (i = 0; i < a->nzcnt; i++)
+	{
+		int idx = a->indx[i];
+		EGLPNUM_TYPENAME_EGlpNumCopy (work[idx], a->coef[i]);
+		if (!mark[idx])
+		{
+			mark[idx] = 1;
+			list[n++] = idx;
+		}
+	}
+	for (k = f->pf_cnt - 1; k >= 0; k--)
+	{
+		int p = f->pf_p[k];
+		int beg = f->pf_beg[k];
+		int cnt = f->pf_nzcnt[k];
+		int *indx = f->pf_indx + beg;
+		EGLPNUM_TYPE *coef = f->pf_coef + beg;
+		EGLPNUM_TYPENAME_EGlpNumCopy (dot, work[p]);
+		for (i = 0; i < cnt; i++)
+		{
+			int idx = indx[i];
+			if (mark[idx])
+				EGLPNUM_TYPENAME_EGlpNumSubInnProdTo (dot, coef[i], work[idx]);
+		}
+		if (EGLPNUM_TYPENAME_EGlpNumIsNeqqZero (dot))
+		{
+			EGLPNUM_TYPENAME_EGlpNumDivTo (dot, f->pf_piv[k]);
+			EGLPNUM_TYPENAME_EGlpNumCopy (work[p], dot);
+			if (!mark[p])
+			{
+				mark[p] = 1;
+				list[n++] = p;
+			}
+		}
+		else if (mark[p])
+		{
+			EGLPNUM_TYPENAME_EGlpNumZero (work[p]);
+		}
+	}
+	for (i = 0; i < n; i++)
+	{
+		int idx = list[i];
+		mark[idx] = 0;
+		if (EGLPNUM_TYPENAME_EGlpNumIsNeqqZero (work[idx]))
+		{
+			out->indx[out_nz] = idx;
+			EGLPNUM_TYPENAME_EGlpNumCopy (out->coef[out_nz], work[idx]);
+			out_nz++;
+		}
+		EGLPNUM_TYPENAME_EGlpNumZero (work[idx]);
+	}
+	out->nzcnt = out_nz;
+	EGLPNUM_TYPENAME_EGlpNumClearVar (dot);
+}
