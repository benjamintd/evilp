+static int pf_ensure_buffers (
+	EGLPNUM_TYPENAME_factor_work * f,
+	int need_entries)
+{
+	int rval = 0;
+	int max_etas = 128;
+	(void) rval;
+	if (f->pf_max < max_etas)
+	{
+		ILL_IFFREE(f->pf_beg);
+		ILL_IFFREE(f->pf_nzcnt);
+		ILL_IFFREE(f->pf_p);
+		EGLPNUM_TYPENAME_EGlpNumFreeArray (f->pf_piv);
+		f->pf_max = 0;
+		ILL_SAFE_MALLOC (f->pf_beg, max_etas, int);
+		ILL_SAFE_MALLOC (f->pf_nzcnt, max_etas, int);
+		ILL_SAFE_MALLOC (f->pf_p, max_etas, int);
+		f->pf_piv = EGLPNUM_TYPENAME_EGlpNumAllocArray (max_etas);
+		if (!f->pf_piv)
+			return E_UPDATE_NOSPACE;
+		f->pf_max = max_etas;
+	}
+	if (f->dim > f->pf_mark_cap)
+	{
+		int cap = f->dim + (f->dim >> 2) + 32;
+		ILL_IFFREE(f->pf_mark);
+		EGLPNUM_TYPENAME_ILLsvector_free (&f->pf_tmp);
+		f->pf_mark_cap = 0;
+		ILL_SAFE_MALLOC (f->pf_mark, cap, unsigned char);
+		memset (f->pf_mark, 0, (size_t) cap);
+		if (EGLPNUM_TYPENAME_ILLsvector_alloc (&f->pf_tmp, cap))
+			return E_UPDATE_NOSPACE;
+		f->pf_mark_cap = cap;
+	}
+	if (f->pf_freebeg + need_entries > f->pf_space)
+	{
+		int max_space = f->dim * 16;
+		int next;
+		int *nindx;
+		if (max_space < 65536)
+			max_space = 65536;
+		if (f->pf_freebeg + need_entries > max_space)
+			return E_UPDATE_NOSPACE;
+		next = f->pf_space ? f->pf_space * 2 : 1024;
+		while (next < f->pf_freebeg + need_entries)
+			next *= 2;
+		if (next > max_space)
+			next = max_space;
+		nindx = ILLutil_reallocrus (f->pf_indx, (size_t) next * sizeof (*nindx));
+		if (!nindx)
+			return E_UPDATE_NOSPACE;
+		f->pf_indx = nindx;
+		EGLPNUM_TYPENAME_EGlpNumReallocArray (&f->pf_coef, next);
+		f->pf_space = next;
+	}
+	return 0;
+CLEANUP:
+	return E_UPDATE_NOSPACE;
+}
