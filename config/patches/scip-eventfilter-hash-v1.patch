+/** hash function for event filter lookup */
+static
+unsigned int eventfilterHash(
+   SCIP_EVENTTYPE const  eventtype,          /**< event type */
+   SCIP_EVENTHDLR*const  eventhdlr,          /**< event handler */
+   SCIP_EVENTDATA*const  eventdata,          /**< event data */
+   unsigned int const    mask                /**< hashsize - 1 */
+   )
+{
+   uint64_t x = (uint64_t)(uintptr_t)eventdata
+      ^ ((uint64_t)(uintptr_t)eventhdlr * 0x9e3779b97f4a7c15ULL)
+      ^ ((uint64_t)eventtype * 0xbf58476d1ce4e5b9ULL);
+   x ^= x >> 30;
+   x *= 0xbf58476d1ce4e5b9ULL;
+   x ^= x >> 27;
+   x *= 0x94d049bb133111ebULL;
+   x ^= x >> 31;
+   return (unsigned int)(x & (uint64_t)mask);
+}
+
+/** builds or rebuilds the lazy hash index over all active eventfilter entries */
+static
+SCIP_RETCODE eventfilterBuildHash(
+   SCIP_EVENTFILTER*     eventfilter,        /**< event filter */
+   BMS_BLKMEM*           blkmem              /**< block memory buffer */
+   )
+{
+   int newhashsize;
+   int target;
+   int i;
+
+   assert(eventfilter != NULL);
+   assert(blkmem != NULL);
+   assert(eventfilter->size > 0);
+
+   target = eventfilter->size > (INT_MAX / 2) ? eventfilter->size : eventfilter->size * 2;
+   newhashsize = 256;
+   while( newhashsize < target && newhashsize <= (INT_MAX / 2) )
+      newhashsize <<= 1;
+
+   if( eventfilter->hashnext == NULL )
+   {
+      SCIP_ALLOC( BMSallocBlockMemoryArray(blkmem, &eventfilter->hashnext, eventfilter->size) );
+   }
+   if( eventfilter->hashhead != NULL )
+   {
+      BMSfreeBlockMemoryArray(blkmem, &eventfilter->hashhead, eventfilter->hashsize);
+      eventfilter->hashsize = 0;
+   }
+   SCIP_ALLOC( BMSallocBlockMemoryArray(blkmem, &eventfilter->hashhead, newhashsize) );
+   eventfilter->hashsize = newhashsize;
+
+   for( i = 0; i < newhashsize; ++i )
+      eventfilter->hashhead[i] = -1;
+
+   /* insert in ascending order so bucket chains search from largest index down */
+   for( i = 0; i < eventfilter->len; ++i )
+   {
+      if( eventfilter->eventtypes[i] != SCIP_EVENTTYPE_DISABLED && eventfilter->nextpos[i] == -2 )
+      {
+         unsigned int b = eventfilterHash(eventfilter->eventtypes[i], eventfilter->eventhdlrs[i],
+            eventfilter->eventdata[i], (unsigned int)(newhashsize - 1));
+         eventfilter->hashnext[i] = eventfilter->hashhead[b];
+         eventfilter->hashhead[b] = i;
+      }
+      else
+      {
+         eventfilter->hashnext[i] = -1;
+      }
+   }
+
+   return SCIP_OKAY;
+}
