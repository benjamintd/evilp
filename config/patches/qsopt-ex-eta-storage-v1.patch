+/* Grow on the first actual write. er_space still determines exactly when
+ * both update algorithms request a refactorization. */
+static int grow_eta_entries (EGLPNUM_TYPENAME_factor_work *f)
+{
+	int capacity = f->er_capacity;
+	int next = capacity == 0 ? 256 :
+		(capacity > f->er_space / 2 ? f->er_space : 2 * capacity);
+	int *indices;
+	if (next > f->er_space)
+		next = f->er_space;
+	indices = ILLutil_reallocrus (f->erindx, (size_t)next * sizeof(*indices));
+	if (!indices)
+		return E_UPDATE_NOSPACE;
+	f->erindx = indices;
+	EGLPNUM_TYPENAME_EGlpNumReallocArray (&f->ercoef, next);
+	f->er_capacity = next;
+	return 0;
+}
